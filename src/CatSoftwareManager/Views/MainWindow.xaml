<Window x:Class="CatSoftwareManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="猫猫的软件管理器"
        Width="760"
        Height="720"
        MinWidth="680"
        MinHeight="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        ShowActivated="True"
        Topmost="True"
        Deactivated="Window_Deactivated">
  <Border Background="{DynamicResource WindowBackground}"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="18"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26"
                        ShadowDepth="6"
                        Opacity="0.25"
                        Color="#000000" />
    </Border.Effect>
    <Grid Margin="22,18,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="42"
                Height="42"
                CornerRadius="13"
                Background="{DynamicResource AccentSoft}"
                VerticalAlignment="Center">
          <TextBlock Text="猫"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Accent}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle}"
                     Margin="0,2,0,0"
                     Foreground="{DynamicResource SecondaryText}"
                     FontSize="12" />
        </StackPanel>

        <Button Grid.Column="2"
                Content="⚙"
                ToolTip="{Binding SettingsText}"
                Width="34"
                Height="34"
                Margin="6,0"
                Style="{StaticResource GhostButtonStyle}"
                FontSize="17"
                Click="SettingsButton_Click" />

        <Button Grid.Column="3"
                Content="✕"
                Width="34"
                Height="34"
                Style="{StaticResource GhostButtonStyle}"
                FontSize="15"
                Click="CloseButton_Click" />
      </Grid>

      <Grid Grid.Row="1" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding SearchHint}"
                 VerticalContentAlignment="Center"
                 Height="38" />
        <TextBlock Text="{Binding SearchHint}"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource SecondaryText}"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button Grid.Column="1"
                Content="{Binding RefreshText}"
                Style="{StaticResource AccentButtonStyle}"
                Command="{Binding RefreshCommand}"
                Margin="10,0,0,0"
                MinWidth="100" />
      </Grid>

      <Border x:Name="SettingsPanel"
              Grid.Row="2"
              Margin="0,12,0,0"
              Padding="14"
              CornerRadius="12"
              Background="{DynamicResource SurfaceAlt}"
              BorderBrush="{DynamicResource BorderColor}"
              BorderThickness="1"
              Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{Binding LanguageText}"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="11.5"
                       Margin="0,0,0,5" />
            <ComboBox SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{Binding ChineseText}" />
              <ComboBoxItem Content="{Binding EnglishText}" />
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{Binding ThemeText}"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="11.5"
                       Margin="0,0,0,5" />
            <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{Binding SystemThemeText}" />
              <ComboBoxItem Content="{Binding LightThemeText}" />
              <ComboBoxItem Content="{Binding DarkThemeText}" />
            </ComboBox>
          </StackPanel>

          <CheckBox Grid.Row="1"
                    Grid.ColumnSpan="2"
                    IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                    Content="{Binding AutoStartText}"
                    Margin="0,12,0,0" />

          <DockPanel Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Margin="0,10,0,0">
            <TextBlock Text="{Binding VersionText}"
                       Foreground="{DynamicResource SecondaryText}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
              <Button Content="{Binding OpenLogsText}"
                      Style="{StaticResource GhostButtonStyle}"
                      Click="OpenLogsButton_Click" />
              <Button Content="{Binding CheckManagerUpdateText}"
                      Style="{StaticResource GhostButtonStyle}"
                      Margin="4,0,0,0"
                      Click="CheckManagerUpdateButton_Click" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,8">
          <TextBlock Text="{Binding SummaryText}"
                     FontWeight="SemiBold" />
          <CheckBox Content="{Binding UpdatesOnlyText}"
                    IsChecked="{Binding OnlyUpdates, Mode=TwoWay}"
                    HorizontalAlignment="Right" />
        </DockPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="13"
                ClipToBounds="True">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding VisibleApps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="8,8,8,0"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                              <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="7,2"
                                    CornerRadius="5"
                                    Background="{DynamicResource ButtonBackground}"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding StatusText}"
                                         FontSize="10.5"
                                         Foreground="{DynamicResource SecondaryText}" />
                            </Border>
                          </Grid>
                          <TextBlock Text="{Binding Publisher}"
                                     Foreground="{DynamicResource SecondaryText}"
                                     FontSize="11"
                                     Margin="0,3,0,0"
                                     TextTrimming="CharacterEllipsis" />
                          <WrapPanel Margin="0,7,0,0"
                                     VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="11.5" />
                            <TextBlock Text="{Binding CurrentVersion}"
                                       Margin="5,0,0,0"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="  →  "
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="11.5" />
                            <TextBlock Text="{Binding LatestLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="11.5" />
                            <TextBlock Text="{Binding LatestVersion}"
                                       Margin="5,0,0,0"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                          </WrapPanel>
                          <TextBlock Text="{Binding SourceText}"
                                     Foreground="{DynamicResource SecondaryText}"
                                     FontSize="10.5"
                                     Margin="0,5,0,0"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="{Binding PrimaryActionText}"
                                Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanUpdate}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="76"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0" />

                        <Button Grid.Column="2"
                                Content="{Binding SecondaryActionText}"
                                Command="{Binding DataContext.ToggleRowStateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"
                                Padding="9,6"
                                VerticalAlignment="Center">
                          <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource BaseButtonStyle}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding CanIgnore}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanRestore}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding EmptyText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Border Background="#AA000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
              <Border Background="{DynamicResource SurfaceBackground}"
                      CornerRadius="12"
                      Padding="24,18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1">
                <StackPanel>
                  <ProgressBar IsIndeterminate="True"
                               Width="190"
                               Height="5"
                               Foreground="{DynamicResource Accent}"
                               Background="{DynamicResource ButtonBackground}" />
                  <TextBlock Text="{Binding BusyMessage}"
                             Margin="0,12,0,0"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>
              </Border>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="4" Margin="2,12,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding FooterText}"
                   Foreground="{DynamicResource SecondaryText}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Title}"
                   Foreground="{DynamicResource DisabledText}"
                   FontSize="10.5"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>

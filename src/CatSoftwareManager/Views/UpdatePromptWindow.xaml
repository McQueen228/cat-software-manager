<Window x:Class="CatSoftwareManager.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700"
        Height="570"
        MinWidth="600"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
  <Border Background="{DynamicResource WindowBackground}"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="16">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        Opacity="0.28"
                        ShadowDepth="5"
                        Color="#000000" />
    </Border.Effect>
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0"
                 MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Button DockPanel.Dock="Right"
                Content="✕"
                Width="32"
                Height="32"
                Style="{StaticResource GhostButtonStyle}"
                Click="CancelButton_Click" />
        <StackPanel>
          <TextBlock Text="{Binding PromptTitle}"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding PromptSummary}"
                     Margin="0,5,0,0"
                     Foreground="{DynamicResource SecondaryText}" />
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="ProgressText"
                 Grid.Row="1"
                 Margin="0,12,0,0"
                 Foreground="{DynamicResource Accent}"
                 FontWeight="SemiBold" />

      <Border Grid.Row="2"
              Margin="0,12,0,0"
              Background="{DynamicResource SurfaceBackground}"
              BorderBrush="{DynamicResource BorderColor}"
              BorderThickness="1"
              CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="UpdateItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="8"
                        Padding="12,10"
                        CornerRadius="9"
                        Background="{DynamicResource SurfaceAlt}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Click="SelectionChanged"
                              Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                      <DockPanel>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center" />
                      </DockPanel>
                      <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding CurrentLabel}"
                                   Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding CurrentVersion}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="  →  "
                                   Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding LatestLabel}"
                                   Foreground="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding LatestVersion}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold" />
                      </WrapPanel>
                      <TextBlock Text="{Binding SourceText}"
                                 Margin="0,5,0,0"
                                 Foreground="{DynamicResource SecondaryText}"
                                 FontSize="10.5" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="3" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="IgnoreButton"
                  Content="{Binding IgnoreSelectedText}"
                  Style="{StaticResource BaseButtonStyle}"
                  Click="IgnoreButton_Click" />
          <Button x:Name="SkipButton"
                  Content="{Binding SkipSelectedText}"
                  Style="{StaticResource BaseButtonStyle}"
                  Margin="8,0,0,0"
                  Click="SkipButton_Click" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
          <Button Content="{Binding CancelText}"
                  Style="{StaticResource BaseButtonStyle}"
                  MinWidth="78"
                  Click="CancelButton_Click" />
          <Button x:Name="ConfirmButton"
                  Content="{Binding ConfirmSelectedText}"
                  Style="{StaticResource AccentButtonStyle}"
                  MinWidth="104"
                  Margin="8,0,0,0"
                  Click="ConfirmButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
